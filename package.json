{
  "name": "github-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node --experimental-strip-types scripts/patch-jsqr.ts",
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/check-source-integrity.mjs && vue-tsc --noEmit && vite build",
    "test": "vitest run tests",
    "preview": "vite preview --host 0.0.0.0",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@lucide/vue": "^1.57.0",
    "jsqr": "^1.4.0",
    "markdown-it": "^15.0.2",
    "qrcode": "^1.5.4",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.18.0",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "~5.9.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "vue-tsc": "^3.1.1"
  },
  "license": "MIT",
  "author": "Olof Wingren"
}
